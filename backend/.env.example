# SQLite (Desenvolvimento / Testes locais zero-config)
DATABASE_URL="file:./dev.db"

# Para produção / MySQL (dbDomus), altere o provider no prisma/schema.prisma para "mysql" e use:
# DATABASE_URL="mysql://usuario:senha@localhost:3306/dbDomus"

# Autenticação e Segurança
JWT_SECRET="troque-por-uma-chave-secreta-forte-em-producao"
JWT_EXPIRES_IN="8h"

# Servidor e Rede
PORT=3000
# CORS_ORIGIN="http://localhost:8081,http://localhost:3000"

# Opcional para desenvolvimento / testes rápidos sem token:
# DISABLE_AUTH=false

