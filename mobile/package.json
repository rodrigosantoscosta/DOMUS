{
  "name": "domus-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:apk": "npx --yes eas-cli build -p android --profile preview",
    "build:apk:local": "npx --yes eas-cli build -p android --profile preview --local",
    "export:web": "expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.3.0",
    "@shopify/flash-list": "2.3.3",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-haptics": "^58.0.7",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "^0.13.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "jest": "~30.5.2",
    "react-test-renderer": "^19.3.1",
    "ts-jest": "^29.2.6",
    "typescript": "~6.0.3",
    "deepmerge": "file:./vendor/deepmerge-4.3.2.tgz"
  },
  "private": true,
  "overrides": {
    "minimatch": "^11.0.5",
    "glob": "^14.0.4",
    "deepmerge": "$deepmerge"
  }
}
