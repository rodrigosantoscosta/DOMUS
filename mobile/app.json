{
  "expo": {
    "name": "DOMUS",
    "slug": "domus-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFE099"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFE099",
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
