# URL base da API DOMUS Backend (NestJS)
# Se omitido, o app detecta automaticamente o host no navegador (Web) e via Expo Host (celular)
# Exemplo para emulador/dispositivo local ou rede Wi-Fi:
EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Para testes com celular fisico na rede Wi-Fi, voce pode fixar o IP da sua maquina:
# EXPO_PUBLIC_API_URL=http://192.168.1.15:3000/api
